ARG NODE_VERSION=24.18.0
ARG PNPM_VERSION=12.18.0

# ==================== 阶段 1：编译 ====================
FROM node:${NODE_VERSION}-alpine AS builder

ARG PNPM_VERSION

WORKDIR /app

# 先拷依赖清单与 pnpm 配置：只改业务代码时，下面两层缓存不会失效
# 工程已改为独立安装，不再有 workspace，故只需 server 自己的清单与锁文件
COPY apps/server/package.json apps/server/pnpm-lock.yaml apps/server/pnpm-workspace.yaml ./
# npm 全局安装不读 pnpm-workspace.yaml 里的 registry，必须显式指定，否则国内会卡在 npmjs
RUN npm i -g pnpm@${PNPM_VERSION} --registry=https://registry.npmmirror.com
# store 走 BuildKit cache mount：依赖包跨构建复用，且挂载内容不进镜像层
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# 整个 server 工程落地到 /app（node_modules/dist/logs 已被 .dockerignore 排除）
# nest-cli.json 的 rspack builder 依赖同目录的 rspack.config.ts，故不能只拷零散配置
COPY apps/server/ ./
# @nestjs/cli 的 rspack 编译器硬编码 stats.toString({ colors: true })，
# 容器内非 TTY 时 ANSI 转义码会原样打进构建日志变成乱码，故先捕获再剥离后输出
RUN pnpm build > /tmp/build.log 2>&1; \
    build_status=$?; \
    node -e "const log = require('node:fs').readFileSync('/tmp/build.log', 'utf8').replace(/\u001b\[[0-9;]*m/g, ''); process.stdout.write(log)"; \
    exit $build_status

# ==================== 阶段 2：生产依赖 + 产物 ====================
FROM node:${NODE_VERSION}-alpine AS deployer

ARG PNPM_VERSION

WORKDIR /deploy

# pnpm deploy 仅适用于 workspace，工程已改为独立安装，故直接装生产依赖
COPY apps/server/package.json apps/server/pnpm-lock.yaml apps/server/pnpm-workspace.yaml ./
RUN npm i -g pnpm@${PNPM_VERSION} --registry=https://registry.npmmirror.com
# store 走 BuildKit cache mount：与 builder 阶段共用缓存，且内容不进镜像层
# node_modules 是指向 store 的硬链接，挂载卸载后链接依然有效，最终只剩实际依赖的体积
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile \
 && npm rm -g pnpm

# 构建产物合并进部署根目录，main.js 与 node_modules 同级
COPY --from=builder /app/dist/ ./

# ==================== 阶段 3：运行 ====================
FROM node:${NODE_VERSION}-alpine AS runner

WORKDIR /app

# NODE_ENV 必须显式声明，否则 winston 不写文件日志
# TZ + tzdata + /etc/localtime 三者齐备，见下面的时区注释
ENV NODE_ENV=production \
    TZ=Asia/Shanghai \
    SERVER_PORT=3000 \
    SERVER_GLOBAL_PREFIX=/api

# 时区：本项目 dayjs(本地时区) / winston 日志文件名 / BullMQ cron 都依赖它，
#       故 tzdata 常驻不卸载（约 3MB，换来命名时区解析无盲区）
# - TZ=Asia/Shanghai 供 Node 与读 TZ 的进程使用
# - /etc/localtime 软链兜底 libc / busybox 的默认时区
# 国内构建慢可在 apk 前加：
#   sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories
RUN apk add --no-cache tzdata \
 && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && mkdir -p logs/info logs/error uploads \
 && chown -R node:node /app/logs /app/uploads

# 平铺部署包（生产依赖 + 构建产物）
COPY --from=deployer --chown=node:node /deploy .
# 探针脚本，配合下面的 HEALTHCHECK 使用
COPY --chown=node:node apps/server/scripts/healthcheck.js ./scripts/healthcheck.js

# 非 root 运行；日志目录 logs/、上传目录 uploads/ 都相对 process.cwd()，即 /app
USER node

EXPOSE 3000

# 探 /api/monitor/health/live（@Public + 无外部依赖，不会因 DB/Redis 抖动而误判）
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "scripts/healthcheck.js"]

# exec 形式启动，node 直接收到 SIGTERM，配合 main.ts 的 enableShutdownHooks() 优雅退出
CMD ["node", "main.js"]

{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "typeorm": "esno -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ormconfig.ts",
    "migration:generate": "npm run typeorm migration:generate src/database/migrations/init",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "db:init": "node scripts/init-db.mjs",
    "build": "cross-env NODE_ENV=production nest build",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/typeorm": "^12.0.3",
    "argon2": "0.45.2",
    "axios": "^1.21.1",
    "bullmq": "6.7.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron-parser": "5.10.6",
    "dayjs": "^1.11.23",
    "dotenv": "18.0.10",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "iconv-lite": "0.7.3",
    "ioredis": "6.0.0",
    "ip2region-ts": "2.0.1",
    "lodash-es": "^4.18.1",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "nest-winston": "2.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-captcha": "1.4.0",
    "systeminformation": "5.33.23",
    "typeorm": "1.1.3",
    "ua-parser-js": "2.0.10",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@rspack/cli": "2.3.3",
    "@rspack/core": "^2.3.3",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "esno": "4.8.0",
    "globals": "^17.14.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1",
    "webpack-node-externals": "3.0.0"
  }
}

# 服务器监听端口
SERVER_PORT=3000
# 全局接口路径前缀
SERVER_GLOBAL_PREFIX=/api
# 是否演示环境
SERVER_IS_DEMO=false

# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 连接密码（本地无密码可留空，留空则客户端不传密码）
REDIS_PASSWORD=X48MzS9JEmvSl4ny
# Redis 数据库索引
REDIS_DB=0

# 数据库主机地址
MYSQL_HOST=127.0.0.1
# 数据库端口
MYSQL_PORT=3306
# 数据库用户名（生产环境建议使用最小权限账号，避免 root）
MYSQL_USERNAME=root
# 数据库密码（生产环境必须使用强密码，且不要提交到仓库）
MYSQL_PASSWORD=OE7NhmYNWc8SXwid
# 数据库名称，需提前在 MySQL 中创建
MYSQL_DATABASE=nestdemo
# 是否自动同步实体与数据库表结构（TypeORM）
MYSQL_SYNCHRONIZE=true

# JWT 签名密钥（用于签发与校验访问令牌，生产环境务必使用强随机值，禁止提交到仓库）
JWT_SECRET=80464BA1E96A7A86941B13AE69431E1A
# JWT 访问令牌有效期（单位：秒，1800 = 30 分钟）
JWT_EXPIRES_IN=1800
# JWT 刷新令牌有效期（单位：秒，604800 = 7 天，滑动续期）
JWT_REFRESH_EXPIRES_IN=604800